# Sentinel Agents - standalone Kafka streaming consumer.
#
# This image runs the agents library as an independent Kafka consumer
# (`python -m sentinel_agents.streaming`), used by docker-compose.kafka.yml for
# high-throughput streaming ingestion. It bundles the maturin-built Rust
# sentinel_core engine so the streaming path also benefits from the fast
# Sigma engine. (The synchronous request path lives in the api image, which
# imports this same library in-process.)

# ---- Stage 1: build the Rust core into a Python wheel via maturin ----
FROM rust:1.83-slim AS core-builder
WORKDIR /build
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --break-system-packages maturin
COPY sentinel-core /build/sentinel-core
COPY rules /build/rules
WORKDIR /build/sentinel-core
RUN maturin build --release --features pyo3 --out /wheels

# ---- Stage 2: runtime image ----
FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r sentinel && useradd -r -g sentinel sentinel

# Install the Rust core engine wheel (provides `import sentinel_core`)
COPY --from=core-builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl

# Copy and install the agents library
COPY sentinel-agents /app/sentinel-agents
COPY rules /app/rules
WORKDIR /app/sentinel-agents
RUN pip install --no-cache-dir .

RUN chown -R sentinel:sentinel /app

USER sentinel

# Run the Kafka streaming consumer (real entrypoint; there is no gRPC server).
CMD ["python", "-m", "sentinel_agents.streaming"]
